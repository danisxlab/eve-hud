{
  "name": "eve-hud-app",
  "productName": "EVE HUD",
  "version": "1.1.2",
  "description": "EVE HUD: a live EVE Online second-screen HUD, powered by ESI, as a desktop app.",
  "type": "module",
  "main": "src/main.js",
  "private": true,
  "author": "danisxlab",
  "homepage": "https://github.com/danisxlab/eve-hud",
  "desktopName": "eve-hud.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danisxlab/eve-hud.git"
  },
  "bugs": {
    "url": "https://github.com/danisxlab/eve-hud/issues"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "fresh": "electron . --data-dir=./.test-home",
    "rebuild-map": "electron . --rebuild-map",
    "check": "node scripts/check.js",
    "checksums": "node scripts/checksums.js",
    "site": "node scripts/build-site.js _site",
    "site:preview": "node scripts/build-site.js _site --preview",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:set": "npm version --no-git-tag-version",
    "test": "node --import ./test/fake-electron/register.js --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win --config electron-builder.config.cjs",
    "dist:win-zip": "electron-builder --win zip --x64 --config electron-builder.config.cjs",
    "dist:mac": "electron-builder --mac --config electron-builder.config.cjs",
    "dist:mac-dev": "MAC_SIGN=development electron-builder --mac --config electron-builder.config.cjs",
    "dist:linux": "electron-builder --linux --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
